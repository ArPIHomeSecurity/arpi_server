ZigbeeDevices {
    width: 100%;
    height: auto;
    background: black 100%;
}

#zigbee-pane {
    overflow: auto;
}

#zigbee {
    layout: vertical;
    width: 100%;
    height: auto;
    padding: 1 2 1 2;
    background: black 100%;
    overflow: auto;
}

.zigbee-row {
    height: 3;
    margin-bottom: 1;
}

.zigbee-label {
    height: 3;
    padding: 1 2;
}

#zigbee Input {
    height: 3;
    margin: 0 0 1 0;
}

#zigbee Checkbox {
    width: auto;
    margin: 0 0 1 0;
}

#zigbee Select {
    width: 100%;
    height: 3;
    margin: 0 0 1 0;
}

#zigbee-telemetry-row,
#zigbee-actions {
    width: 100%;
    height: auto;
    layout: horizontal;
    margin: 0 0 1 0;
}

#zigbee-telemetry-row Input {
    width: 1fr;
    margin-right: 1;
}

#zigbee-actions Button {
    width: auto;
    min-width: 20;
    height: 3;
    margin-right: 1;
    background: green 60%;
    color: white 100%;
}

#zigbee-devices {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
}

.zigbee-device-row {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
    padding: 0 0 1 0;
    border-bottom: solid $surface;
}

.zigbee-device-label {
    width: 100%;
    height: auto;
    padding: 0 0 1 0;
    color: white 90%;
}

.zigbee-property {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
}

.zigbee-no-device {
    width: 100%;
    height: auto;
    color: white 60%;
}
