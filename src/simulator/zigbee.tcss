ZigbeeDevices {
    width: 100%;
    height: auto;
    background: black 100%;
}

#zigbee-tab {
    overflow: auto;
}

#zigbee {
    layout: vertical;
    width: 100%;
    height: auto;
    padding: 1 2 1 2;
    background: black 100%;
    overflow: auto;
}

#zigbee Input {
    width: 100%;
    height: 3;
    margin: 0 0 1 0;
}

#zigbee Checkbox {
    width: auto;
    margin: 0 0 1 0;
}

#zigbee Select {
    width: 100%;
    height: 3;
    margin: 0 0 1 0;
}

#zigbee-pairing-row,
#zigbee-telemetry-row,
#zigbee-actions {
    width: 100%;
    height: auto;
    layout: horizontal;
    margin: 0 0 1 0;
}

#zigbee-pairing-row Input,
#zigbee-telemetry-row Input {
    width: 1fr;
    margin-right: 1;
}

#zigbee-actions Button {
    width: 1fr;
    min-width: 15;
    height: 3;
    margin-right: 1;
    background: green 60%;
    color: white 100%;
}

#zigbee-summary {
    width: 100%;
    height: auto;
    padding: 1 0 1 0;
    color: white 90%;
    background: rgba(31, 31, 31, 0.8);
}
