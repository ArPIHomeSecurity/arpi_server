###########################################################
# COMMON
PYTHONPATH=src
PYTHONUNBUFFERED=1
TIMEZONE=CET

# database
DB_USER=argus
DB_SCHEMA=argus
DB_HOST=/var/run/postgresql_test

# interfaces
MONITOR_INPUT_SOCKET=/tmp/argus/argus_monitor.sock
MOCK_INPUT_FILE=pytest_input.json
MOCK_OUTPUT_FILE=pytest_output.json
MOCK_KEYPAD_FILE=pytest_keypad.json

MONITOR_HOST=127.0.0.1
MONITOR_PORT=18081

SERVER_HOST=127.0.0.1
SERVER_PORT=18080

USE_SSH_CONNECTION=false

###########################################################
# MONITOR
PERMISSIONS=660

# sample per seconds
SAMPLE_RATE=10

# Board version: 2 = GPIO, 3 = SPI/AD converters (required)
BOARD_VERSION=3
INPUT_NUMBER=15
OUTPUT_NUMBER=8

GSM_PORT=/dev/ttyAMA0
GSM_PORT_BAUD=9600

USE_SIMULATOR=true

###########################################################
# SERVER
USE_SECURE_CONNECTION=false
