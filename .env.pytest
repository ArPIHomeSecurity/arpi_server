###########################################################
# COMMON
FLASK_ENV=development
PYTHONPATH=src
PYTHONUNBUFFERED=1
TIMEZONE=CET

# database
DB_USER=argus
DB_SCHEMA=argus
DB_HOST=/tmp/argus/postgresql_test

# interfaces
MONITOR_INPUT_SOCKET=/tmp/argus_monitor/argus_monitor.sock

MONITOR_HOST=127.0.0.1
MONITOR_PORT=18081

SERVER_HOST=127.0.0.1
SERVER_PORT=18080

USE_SSH_CONNECTION=false

###########################################################
# MONITOR
PERMISSIONS=660

# sample per seconds
SAMPLE_RATE=10

# Board version: 2 = GPIO, 3 = SPI/AD converters (required)
BOARD_VERSION=3
INPUT_NUMBER=15
OUTPUT_NUMBER=8

GSM_PORT=/dev/ttyAMA0
GSM_PORT_BAUD=9600

STATUS_FILE=status_tests.json
SIMULATOR_INPUT_FILE=pytest_input.json
SIMULATOR_OUTPUT_FILE=pytest_output.json
SIMULATOR_KEYPAD_FILE=pytest_keypad.json
SIMULATOR_ZIGBEE_FILE=pytest_zigbee.json

USE_SIMULATOR=true
USE_ZIGBEE_SIMULATOR=true

ARGUS_MQTT_HOSTNAME=localhost
ARGUS_MQTT_PORT=2883
ARGUS_MQTT_CA_CERT=./src/installer/installers/etc/nginx/ssl/arpi_ca.crt
ARGUS_TLS_ENABLED=false
ARGUS_TLS_INSECURE=true

###########################################################
# SERVER
USE_SECURE_CONNECTION=false
SECRET=seekrat

###########################################################
# SECRETS
ARGUS_READER_MQTT_PASSWORD=argus_reader_password
ARGUS_CONTROL_MQTT_PASSWORD=argus_control_password