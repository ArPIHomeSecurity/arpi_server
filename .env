###########################################################
# COMMON
PYTHONPATH=src
PYTHONUNBUFFERED=1
TIMEZONE=CET

# database
DB_HOST=/tmp/argus/argus_database
DB_USER=argus
DB_SCHEMA=argus

# interfaces
MONITOR_INPUT_SOCKET=/tmp/argus/argus_monitor/argus_monitor.sock

MONITOR_HOST=127.0.0.1
MONITOR_PORT=8081

FLASK_ENV=development
USE_SSH_CONNECTION=false

###########################################################
# MONITOR
USERNAME=${USER}
GROUPNAME=${USER}
PERMISSIONS=660

# sample per seconds
SAMPLE_RATE=1

# Board version: 2 = GPIO, 3 = SPI/AD converters (required)
BOARD_VERSION=3
INPUT_NUMBER=15
OUTPUT_NUMBER=8

GSM_PORT=/dev/ttyAMA0
GSM_PORT_BAUD=9600

STATUS_FILE=status.json

ZIGBEE_DATABASE_PATH=zigbee.db

USE_SIMULATOR=true
USE_ZIGBEE_SIMULATOR=true

ARGUS_MQTT_HOSTNAME=localhost
ARGUS_MQTT_PORT=1883
ARGUS_MQTT_CA_CERT=./src/installer/installers/etc/nginx/ssl/arpi_ca.crt
ARGUS_TLS_ENABLED=false
ARGUS_TLS_INSECURE=true

###########################################################
# SERVER
USE_SECURE_CONNECTION=false

###########################################################
# SECRETS
ARGUS_MQTT_PASSWORD=argus_password
ARGUS_READER_MQTT_PASSWORD=argus_reader_password
ARGUS_CONTROL_MQTT_PASSWORD=argus_control_password
SECRET=argus
MCP_SECRET=mcp_argus